#838 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#835,
  'distance_accuracy_value','confusion accuracy');
#839 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
