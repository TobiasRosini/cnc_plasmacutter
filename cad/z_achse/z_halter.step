GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#838)) GLOBAL_UNIT_ASSIGNED_CONTEXT
((#835,#836,#837)) REPRESENTATION_CONTEXT('Context #1',
  '3D Context with UNIT and UNCERTAINTY') );
#835 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#836 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
